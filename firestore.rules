rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasOnlyKeys(data, keys) {
      return data.keys().hasOnly(keys);
    }

    function validFurniture(data) {
      return data.name is string &&
        data.name.size() > 0 &&
        data.sku is string &&
        data.sku.size() > 0 &&
        data.status in ['rented', 'available', 'inTransit'] &&
        data.type in [
          'sofa',
          'studyTable',
          'officeChair',
          'bed',
          'diningTable'
        ] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validBooking(data) {
      return data.customerId is string &&
        data.customerId.size() > 0 &&
        data.furnitureId is string &&
        data.furnitureId.size() > 0 &&
        data.startDate is timestamp &&
        data.endDate is timestamp &&
        data.endDate > data.startDate &&
        data.status in [
          'reserved',
          'scheduled',
          'outForDelivery',
          'delivered',
          'active',
          'pickupScheduled',
          'pickedUp',
          'returned',
          'cancelled'
        ] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validCustomer(data) {
      return data.name is string &&
        data.name.size() > 0 &&
        data.phoneNumber is string &&
        data.email is string &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validCustomerBookingCancel(data, prevData) {
      return data.customerId == prevData.customerId &&
        data.furnitureId == prevData.furnitureId &&
        data.startDate == prevData.startDate &&
        data.endDate == prevData.endDate &&
        data.createdAt == prevData.createdAt &&
        prevData.status in ['reserved', 'scheduled'] &&
        data.status == 'cancelled' &&
        validBooking(data);
    }

    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create, update: if (isOwner(customerId) && validCustomer(request.resource.data)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /furniture/{furnitureId} {
      allow read: if signedIn();
      allow create: if isAdmin() && validFurniture(request.resource.data);
      allow update: if isAdmin() &&
        validFurniture(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin() &&
        resource.data.status == 'available';
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if (signedIn() &&
        validCustomerBookingCancel(request.resource.data, resource.data)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /furniture_booking_locks/{furnitureId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
